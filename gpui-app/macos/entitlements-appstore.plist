<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mac App Store build: App Sandbox is mandatory. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Files: whatever the user picks in the native open/save panels
         (powerbox), plus app-scoped bookmarks so session restore and the
         recents list survive relaunch. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>

    <!-- Network client: hub sync (optional, user-initiated). -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
